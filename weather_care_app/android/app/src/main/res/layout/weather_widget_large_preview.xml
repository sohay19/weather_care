<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <include
        layout="@layout/weather_widget_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="아침에는 선선해요. 외출 준비물을 챙기세요."
        android:textColor="@color/weather_widget_text_primary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/weather_widget_panel_background"
        android:gravity="center"
        android:padding="12dp"
        android:text="우산     겉옷     마스크"
        android:textColor="@color/weather_widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="다가오는 날씨   오전 9시   19°"
        android:textColor="@color/weather_widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
