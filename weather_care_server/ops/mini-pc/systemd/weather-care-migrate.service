[Unit]
Description=날씨챙겨 SQLite 마이그레이션
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=weather-care
Group=weather-care
WorkingDirectory=/opt/weather-care/weather_care_server
EnvironmentFile=/etc/weather-care/weather-care.env
ExecStart=/opt/weather-care/weather_care_server/node_modules/.bin/tsx src/node/migrate.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care

[Install]
WantedBy=multi-user.target
