NODE_ENV=production
NODE_DATABASE_PATH=/var/lib/weather-care/weather-care-users-production.sqlite
NODE_WEATHER_DATABASE_PATH=/var/lib/weather-care/weather-care-weather.sqlite
WEATHER_COLLECTION_ENABLED=true
# 중앙 수집기만 다른 환경의 사용자 DB를 읽기 전용으로 추가한다.
NODE_COLLECTION_USER_DATABASE_PATHS=[]
# 양쪽 DB 준비 후 운영 수집기에 ["/var/lib/weather-care/weather-care-users-test.sqlite"]를 설정한다.
NODE_BACKUP_DIR=/var/backups/weather-care
NODE_BACKUP_RETENTION_DAYS=7
NODE_HOST=127.0.0.1
NODE_PORT=8787
APP_ORIGIN=https://api.example.com
FCM_PROJECT_ID=weather-care-2aaa8
GA_PROPERTY_ID=549443110
KMA_SERVICE_KEY=replace-with-public-data-portal-key
KMA_APIHUB_KEY=replace-with-kma-apihub-key
KHOA_SERVICE_KEY=
KWATER_SERVICE_KEY=
NIFS_API_KEY=
HRFCO_API_KEY=
GRID_COLLECTION_CONFIG_PATH=
ITS_API_KEY=replace-with-its-open-api-key
FCM_CLIENT_EMAIL=replace-with-firebase-service-account-email
FCM_PRIVATE_KEY=replace-with-firebase-private-key
GA_ADMIN_CLIENT_EMAIL=replace-with-ga-service-account-email
GA_ADMIN_PRIVATE_KEY=replace-with-ga-private-key
RECOVERY_MODE=off
NATIONWIDE_PRECOLLECT_ENABLED=true
