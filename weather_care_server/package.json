{
  "name": "weather-care-server",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "npm run test:worker && npm run test:node",
    "test:worker": "vitest run",
    "test:node": "vitest run --config vitest.node.config.mts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply weather_care_db --local",
    "db:push": "wrangler d1 execute weather_care_db --file=./migrations/0001_init.sql --local",
    "node:db:migrate": "tsx src/node/migrate.ts",
    "node:db:split": "tsx src/node/splitDatabases.ts",
    "node:db:import": "tsx src/node/importD1.ts",
    "node:boundaries:import": "tsx src/node/importAdministrativeBoundaries.ts",
    "node:server": "tsx src/node/server.ts",
    "node:scheduler": "tsx src/node/scheduler.ts",
    "node:job": "tsx src/node/runJob.ts",
    "node:prewarm": "tsx src/node/prewarmNationwide.ts",
    "node:backup": "tsx src/node/backup.ts",
    "node:api-renewal": "tsx src/node/runApiRenewalReminder.ts",
    "node:store-update": "tsx src/node/runStoreUpdateNotifier.ts",
    "build:store-update": "esbuild src/node/runStoreUpdateNotifier.ts --bundle --platform=node --target=node24 --format=cjs --external:better-sqlite3 --outfile=build/store-update/notifier.cjs",
    "build:api-renewal": "esbuild src/node/runApiRenewalReminder.ts --bundle --platform=node --target=node24 --format=cjs --external:better-sqlite3 --outfile=build/api-renewal/reminder.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "nodemailer": "10.2.1",
    "tsx": "^4.23.13",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.5.2",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  }
}
