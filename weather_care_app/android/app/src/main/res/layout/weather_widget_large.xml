<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_widget_background"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="시흥시 은행동"
            android:scaleType="fitStart" />

        <ImageView
            android:id="@+id/widget_refresh_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="오전 8:20 기준"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/weather_widget_icon_description"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_current_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="현재"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/widget_current_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="18°"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="#ABC3D6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_apparent_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="체감"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/widget_apparent_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="18°"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:contentDescription="오전에는 선선하고 오후에는 포근해요. 얇은 겉옷을 챙기면 좋아요."
            android:scaleType="fitStart" />

        <LinearLayout
            android:id="@+id/widget_preparation_row"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_preparation_1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/weather_widget_panel_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/widget_preparation_icon_1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/weather_widget_preparation_description" />

            <ImageView
                android:id="@+id/widget_preparation_label_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="우산"
                android:scaleType="fitStart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_preparation_2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/weather_widget_panel_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/widget_preparation_icon_2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/weather_widget_preparation_description" />

            <ImageView
                android:id="@+id/widget_preparation_label_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="두꺼운 겉옷"
                android:scaleType="fitStart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_preparation_3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/weather_widget_panel_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/widget_preparation_icon_3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/weather_widget_preparation_description" />

            <ImageView
                android:id="@+id/widget_preparation_label_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="마스크"
                android:scaleType="fitStart" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/widget_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="다음 시간 예보"
            android:scaleType="fitStart" />

        <ImageView
            android:id="@+id/widget_next_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="오전 9시"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/widget_next_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="19°"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/widget_next_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/weather_widget_icon_description"
            android:scaleType="centerInside" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_min_max"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/weather_widget_panel_background"
        android:contentDescription="최저 12° 최고 20°"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:scaleType="centerInside" />
</LinearLayout>
