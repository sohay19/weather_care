[Unit]
Description=날씨챙겨 공용 DB 전국 자외선 관측 수집
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weather-care
Group=weather-care
WorkingDirectory=/opt/weather-care/weather_care_test_server
EnvironmentFile=/etc/weather-care/weather-care.env
ExecStart=/opt/weather-care/weather_care_test_server/node_modules/.bin/tsx src/node/collectTestUv.ts
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care
