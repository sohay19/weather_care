[Unit]
Description=Weather Care ITS relay
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=weather-care-relay
Group=weather-care-relay
WorkingDirectory=/opt/weather-care-relay
EnvironmentFile=/etc/weather-care-relay.env
ExecStart=/usr/bin/node /opt/weather-care-relay/dist/index.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
