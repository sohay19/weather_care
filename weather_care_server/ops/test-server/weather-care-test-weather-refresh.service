[Unit]
Description=날씨챙겨 시험 서버 자외선·생활지수·특보·적설 갱신
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weather-care
Group=weather-care
WorkingDirectory=/opt/weather-care/weather_care_test_server
EnvironmentFile=/etc/weather-care/weather-care.env
EnvironmentFile=/etc/weather-care/weather-care-test.env
ExecStart=/opt/weather-care/weather_care_test_server/node_modules/.bin/tsx src/node/collectTestWeather.ts
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care
