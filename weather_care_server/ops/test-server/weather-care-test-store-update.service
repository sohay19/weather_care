[Unit]
Description=날씨챙겨 시험 스토어 업데이트 확인·푸시
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weather-care
Group=weather-care
WorkingDirectory=/opt/weather-care/store-update-test
EnvironmentFile=/etc/weather-care/weather-care.env
EnvironmentFile=/etc/weather-care/weather-care-test.env
EnvironmentFile=-/etc/weather-care/store-update-test.env
ExecStart=/usr/bin/flock -n /var/lib/weather-care/store-update-test.lock /usr/local/bin/node /opt/weather-care/store-update-test/notifier.cjs
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care
