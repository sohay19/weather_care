[Unit]
Description=날씨챙겨 API 활용기간 갱신 안내 메일
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=weather-care
Group=weather-care
EnvironmentFile=/etc/weather-care/api-renewal.env
WorkingDirectory=/opt/weather-care-api-renewal
ExecStart=/usr/local/bin/node /opt/weather-care-api-renewal/reminder.cjs
Restart=on-failure
RestartSec=1h
TimeoutStartSec=5min
StateDirectory=weather-care-api-renewal
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care-api-renewal
