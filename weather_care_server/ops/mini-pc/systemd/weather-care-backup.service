[Unit]
Description=날씨챙겨 SQLite 백업
After=weather-care-migrate.service
Requires=weather-care-migrate.service

[Service]
Type=oneshot
User=weather-care
Group=weather-care
WorkingDirectory=/opt/weather-care/weather_care_server
EnvironmentFile=/etc/weather-care/weather-care.env
ExecStart=/opt/weather-care/weather_care_server/node_modules/.bin/tsx src/node/backup.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care /var/backups/weather-care
