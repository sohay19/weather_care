[Unit]
Description=날씨챙겨 시험 사용자 DB·공용 날씨 DB 백업
After=weather-care-test-api.service

[Service]
Type=oneshot
User=weather-care
Group=weather-care
WorkingDirectory=/opt/weather-care/weather_care_test_server
EnvironmentFile=/etc/weather-care/weather-care.env
EnvironmentFile=/etc/weather-care/weather-care-test.env
Environment=NODE_BACKUP_DIR=/var/backups/weather-care/test
ExecStart=/opt/weather-care/weather_care_test_server/node_modules/.bin/tsx src/node/backup.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/weather-care /var/backups/weather-care
